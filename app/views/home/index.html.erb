
<!-- FoodieHub Homepage -->

<!-- Welcome Section -->
<section class="py-5 text-white text-center"
         style="background: linear-gradient(135deg, #176b42, #39a56b);">

  <div class="container py-5">

    <h1 class="display-3 fw-bold">
      Welcome to FoodieHub
    </h1>

    <p class="lead mt-3">
      Discover delicious food and drink recipes from around the world.
    </p>

    <p>
      Explore vegetarian dishes, non-vegetarian meals,
      and refreshing drinks.
    </p>

    <%= link_to "Explore Recipes",
        recipes_path,
        class: "btn btn-light btn-lg mt-3 px-4 fw-semibold" %>

  </div>
</section>

<!-- Recipe Collection Statistics -->
<section class="container py-5">

  <div class="row g-4 text-center">

    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100 p-4">
        <h2 class="fw-bold text-success">
          <%= @recipe_count %>
        </h2>
        <p class="mb-0">Recipes Available</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100 p-4">
        <h2 class="fw-bold text-success">
          <%= @category_count %>
        </h2>
        <p class="mb-0">Recipe Categories</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100 p-4">
        <h2 class="fw-bold text-success">
          <%= @ingredient_count %>
        </h2>
        <p class="mb-0">Ingredients</p>
      </div>
    </div>

  </div>
</section>

<!-- Recipe Types -->
<section class="container py-5">

  <h2 class="text-center fw-bold mb-4">
    What Can You Explore?
  </h2>

  <div class="row g-4">

    <!-- Vegetarian -->
    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0">

        <img
          src="https://www.themealdb.com/images/media/meals/llcbn01574260722.jpg"
          class="card-img-top"
          alt="Vegetarian meal"
          style="height: 230px; object-fit: cover;">

        <div class="card-body text-center d-flex flex-column">
          <h4>Vegetarian Recipes</h4>

          <p>
            Discover delicious plant-based dishes.
          </p>

          <%= link_to "Browse Vegetarian",
              recipes_path(category_id: @vegetarian_category&.id),
              class: "btn btn-success mt-auto" %>
        </div>

      </div>
    </div>

    <!-- Non-Vegetarian -->
    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0">

        <img
          src="https://www.themealdb.com/images/media/meals/1529446352.jpg"
          class="card-img-top"
          alt="Non-vegetarian meal"
          style="height: 230px; object-fit: cover;">

        <div class="card-body text-center d-flex flex-column">
          <h4>Non-Vegetarian Recipes</h4>

          <p>
            Explore chicken, meat and seafood dishes.
          </p>

          <%= link_to "Browse Recipes",
              recipes_path,
              class: "btn btn-success mt-auto" %>
        </div>

      </div>
    </div>

    <!-- Drinks -->
    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0">

        <img
          src="https://www.thecocktaildb.com/images/media/drink/5noda61589575158.jpg"
          class="card-img-top"
          alt="Refreshing drink"
          style="height: 230px; object-fit: cover;">

        <div class="card-body text-center d-flex flex-column">
          <h4>Drinks</h4>

          <p>
            Find refreshing beverages and drink recipes.
          </p>

          <%= link_to "Browse Drinks",
              recipes_path(category_id: @drinks_category&.id),
              class: "btn btn-success mt-auto" %>
        </div>

      </div>
    </div>

  </div>
</section>

<!-- Featured Recipes -->
<section class="container py-5">

  <h2 class="text-center fw-bold mb-3">
    Featured Recipes
  </h2>

  <p class="text-center text-muted mb-4">
    Discover recipes from our collection.
  </p>

  <div class="row g-4">

    <% @featured_recipes.each do |recipe| %>

      <div class="col-md-4">

        <div class="card h-100 shadow-sm border-0">

          <%= image_tag recipe.image_url,
              class: "card-img-top",
              style: "height: 220px; object-fit: cover;",
              alt: recipe.title %>

          <div class="card-body d-flex flex-column">

            <h5 class="card-title">
              <%= recipe.title %>
            </h5>

            <p class="text-muted">
              <%= recipe.category.name %>
            </p>

            <%= link_to "View Recipe",
                recipe_path(recipe),
                class: "btn btn-success mt-auto" %>

          </div>

        </div>

      </div>

    <% end %>

  </div>
</section>

<!-- Browse Categories -->
<section class="container py-5">

  <h2 class="text-center fw-bold mb-4">
    Browse by Category
  </h2>

  <div class="d-flex flex-wrap justify-content-center gap-3">

    <% @categories.each do |category| %>

      <%= link_to category.name,
          category_path(category),
          class: "btn btn-outline-success" %>

    <% end %>

  </div>

</section>

<!-- Final Call to Action -->
<section class="container text-center py-5">

  <h2 class="fw-bold">
    Explore Our Recipe Collection
  </h2>

  <p class="lead">
    Browse our recipes, search by name or ingredient,
    and discover different categories.
  </p>

  <%= link_to "View All Recipes",
      recipes_path,
      class: "btn btn-success btn-lg" %>

</section>
