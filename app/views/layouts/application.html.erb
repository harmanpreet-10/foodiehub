
<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "FoodieHub | Recipe Explorer" %></title>

    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="FoodieHub">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    >

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      body {
        background-color: #f8faf8;
        font-family: Arial, sans-serif;
        min-height: 100vh;
      }

      .navbar {
        background-color: #176b42;
      }

      .navbar-brand {
        font-size: 1.6rem;
        font-weight: bold;
      }

      .nav-link {
        font-weight: 500;
      }

      .nav-link:hover {
        color: #ffe49a !important;
      }

      .card {
        border: none;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        transition: transform 0.2s;
      }

      .card:hover {
        transform: translateY(-4px);
      }

      .btn-success {
        background-color: #176b42;
        border-color: #176b42;
      }

      .btn-success:hover {
        background-color: #105233;
        border-color: #105233;
      }

      footer {
        background-color: #173d2c;
        color: white;
        margin-top: 60px;
      }
    </style>
  </head>

  <body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
      <div class="container">
        <%= link_to "🍽 FoodieHub", root_path, class: "navbar-brand" %>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#foodieNavbar"
          aria-controls="foodieNavbar"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="foodieNavbar">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <%= link_to "Home", root_path, class: "nav-link" %>
            </li>

            <li class="nav-item">
              <%= link_to "Explore Recipes", recipes_path, class: "nav-link" %>
            </li>

            <li class="nav-item">
              <%= link_to "About", home_about_path, class: "nav-link" %>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="container-fluid px-0">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="py-4">
      <div class="container text-center">
        <h5>FoodieHub</h5>
        <p class="mb-1">
          Discover vegetarian, non-vegetarian and drink recipes.
        </p>
        <small>
          &copy; <%= Date.current.year %> FoodieHub |
          Ruby on Rails Project
        </small>
      </div>
    </footer>

    <!-- Bootstrap JavaScript -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>
  </body>
</html>
