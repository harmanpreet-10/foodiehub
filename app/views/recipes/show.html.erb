
<div class="container py-5">
  <%= link_to "← Back to Recipes", recipes_path,
      class: "btn btn-outline-success mb-4" %>

  <div class="row g-4">
    <div class="col-md-5">
      <%= image_tag @recipe.image_url,
          class: "img-fluid rounded shadow",
          alt: @recipe.title %>
    </div>

    <div class="col-md-7">
      <h1 class="fw-bold"><%= @recipe.title %></h1>

      <p class="text-muted">
        Category:
        <%= link_to @recipe.category.name,
    category_path(@recipe.category),
    class: "text-success fw-bold" %>
      </p>

      <h3 class="mt-4">Ingredients</h3>

      <ul class="list-group mb-4">
        <% @recipe.recipe_ingredients.each do |item| %>
          <li class="list-group-item">
            <strong><%= item.ingredient.name %></strong>
            — <%= item.quantity %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <div class="card mt-5 p-4">
    <h2>Preparation Instructions</h2>

    <p class="lh-lg">
      <%= simple_format(@recipe.instructions) %>
    </p>
  </div>
</div>
