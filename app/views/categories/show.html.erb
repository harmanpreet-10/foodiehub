
<div class="container py-5">

  <!-- Back Navigation -->
  <%= link_to "← Back to All Recipes",
      recipes_path,
      class: "btn btn-outline-success mb-4" %>

  <!-- Category Header -->
  <div class="bg-light rounded-3 p-4 mb-5 border">

    <span class="badge bg-success mb-3">
      FoodieHub Category
    </span>

    <h1 class="fw-bold mb-3">
      <%= @category.name %> Recipes
    </h1>

    <% if @category.description.present? %>
      <p class="text-muted mb-3">
        <%= @category.description %>
      </p>
    <% else %>
      <p class="text-muted mb-3">
        Explore delicious recipes from the
        <%= @category.name %> category.
      </p>
    <% end %>

    <p class="mb-0 fw-semibold text-success">
      <%= pluralize(@recipes.total_count, "recipe") %> available
    </p>

  </div>

  <!-- Recipe Collection -->
  <% if @recipes.any? %>

    <div class="row g-4">

      <% @recipes.each do |recipe| %>

        <div class="col-md-6 col-lg-4">

          <div class="card h-100 shadow-sm border-0">

            <%= image_tag recipe.image_url,
                class: "card-img-top",
                style: "height: 220px; object-fit: cover;",
                alt: recipe.title %>

            <div class="card-body d-flex flex-column">

              <h5 class="card-title fw-semibold">
                <%= recipe.title %>
              </h5>

              <p class="text-muted small">
                Category: <%= @category.name %>
              </p>

              <%= link_to "View Recipe",
                  recipe_path(recipe),
                  class: "btn btn-success mt-auto" %>

            </div>

          </div>

        </div>

      <% end %>

    </div>

    <!-- Pagination -->
    <div class="d-flex justify-content-center mt-5">
      <%= paginate @recipes %>
    </div>

  <% else %>

    <!-- Empty Category Message -->
    <div class="text-center bg-light rounded-3 border p-5">

      <h3>No Recipes Available</h3>

      <p class="text-muted">
        There are currently no recipes in this category.
        Explore other categories to discover more recipes.
      </p>

      <%= link_to "Explore All Recipes",
          recipes_path,
          class: "btn btn-success mt-2" %>

    </div>

  <% end %>

</div>
